# Copy to .env and fill in.

# Your Xtream Codes / Xtream UI server, including http(s):// and port
XTREAM_URL=http://your-provider.example:8080

# Free key from https://www.themoviedb.org/settings/api (posters, descriptions)
TMDB_API_KEY=

# Metadata language: en-US, es-ES, es-MX, ...
LANGUAGE=en-US
APP_NAME=PLAYGO

# Port on your machine
PLAYGO_PORT=8080
TZ=America/New_York

# Optional: saga admin panel for one Xtream username
SAGAS_ADMIN_ENABLED=false
SAGAS_ADMIN_USER=

# Optional SMTP
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=tls
SMTP_FROM=
